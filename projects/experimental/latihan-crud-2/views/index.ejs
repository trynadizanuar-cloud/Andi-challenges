<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD(Create,Read,Update,Delete)</title>
    <link rel="stylesheet" href="style.css">

</head>

<body>

    <h2>CRUD POSGREESQL (CREATE,READ,UPDATE,DELETE)</h2>
    <a href="create" class="btn btn-create">Create</a>
    <table>
        <tr>
            <th>No</th>
            <th>Name</th>
            <th>Height</th>
            <th>Weight</th>
            <th>Birth Date</th>
            <th>Is Married</th>
            <th>Action</th>
        </tr>
        <% users.forEach((item,index)=>{%>
            <tr>
                <td>
                    <%= index +1 %>
                </td>
                <td>
                    <%= item.name %>
                </td>
                <td>
                    <%= item.height %>
                </td>
                <td>
                    <%= item.weight %>
                </td>
                <td>
                    <%= item.birth_date ? new Date(item.birth_date).toLocaleDateString('en-CA') : '-' %>
                </td>
                <td>
                    <%= item.is_married ? "Yes" : "Not Yet" %>
                </td>
                <td>
                    <a href="/update/<%= item.id %>">Update</a>
                    <a href="/delete/<%= item.id %>" onclick="return confirm ('Delete Data?')">Delete</a>
                </td>
            </tr>
            <%})%>

</body>

</html>