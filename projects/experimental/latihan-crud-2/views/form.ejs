<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adding Data</title>
    <link rel="stylesheet" href="/style.css">

</head>

<body>
    <form action="" method="POST">

        <input type="text" name="name" placeholder="insert your name" value="<%= item.name || '' %>">

        <input type="number" name="height" placeholder="insert your height" value="<%= item.height || '' %>">

        <input type="number" name="weight" placeholder="insert your weight" value="<%= item.weight || '' %>">

        <input type="date" name="birth_date" value="<%= item.birth_date ? item.birth_date.split('T')[0] : '' %>">

        <select name="is_married">

            <option value="">Have you married?</option>

            <option value="1" <%=item.is_married===true ? 'selected' : '' %>>
                Yes
            </option>

            <option value="0" <%=item.is_married===false ? 'selected' : '' %>>
                Not Yet
            </option>
        </select>
        <button type="submit" class="btn btn-save">Save</button>
        <a href="/" class="btn btn-cancel">Cancel</a>

    </form>

</body>

</html>